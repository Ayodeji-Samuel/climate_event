# ANSASphere – Environment variables
# Copy to .env and fill in values before running

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Google Earth Engine
GEE_CREDENTIALS_PATH=ee-my-makinde-2b6858cddb01.json
GEE_PROJECT=ee-my-makinde

# OpenRouter AI (enables advanced AI features — get key at openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Background monitor interval in seconds (default 3600 = 1 hour)
MONITOR_INTERVAL=3600
