# ANSASphere – Environment variables
# Copy to .env and fill in values before running

# Flask ("production" on PythonAnywhere)
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Google Earth Engine (relative paths are resolved against the project folder)
GEE_CREDENTIALS_PATH=ee-my-makinde-2b6858cddb01.json
GEE_PROJECT=ee-my-makinde
# Per-request Earth Engine timeout in ms (PythonAnywhere kills requests at 300 s)
GEE_DEADLINE_MS=90000

# OpenRouter AI (enables advanced AI features — get key at openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Minimum newly-flooded area (km²) before any flood risk level is assigned
FLOOD_MIN_AREA_KM2=1.0

# Flood monitor: comma-separated region ids — nigeria, <state>, <state>/<lga>
MONITOR_REGIONS=kogi,benue,anambra,delta,bayelsa,adamawa
MONITOR_INTERVAL=3600
# Start the in-process monitor thread at boot (local dev only — on
# PythonAnywhere schedule run_monitor.py instead; threads are not supported)
MONITOR_AUTOSTART=false

# Visitor statistics — download the country database with scripts/update_geoip.py
# Day boundaries in hours from UTC (Nigeria/WAT = 1)
VISITS_UTC_OFFSET_HOURS=1
# A browser counts as a new visit after this many minutes without loading the site
VISIT_SESSION_MINUTES=30
